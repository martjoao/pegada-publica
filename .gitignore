# ─── Data — never commit ───────────────────────────────────────────────
# All fetched/derived data is regenerated by the ETL and build stages.
# Includes API raw landing files, bulk dumps (TSE, Receita Federal CNPJ),
# local databases, and pre-generated site JSON.
data/
**/data/
*.sqlite
*.sqlite3
*.db
*.duckdb

# Bulk download archives (TSE / Receita Federal dumps are large)
*.csv
*.zip
*.gz
*.7z
*.parquet

# Site public-data mirror (regenerated on demand)
/site/public/data/

# NOTE: /build/output/ is intentionally committed — it is the public open-data
# artifact and the build-time input the CI Astro build reads (see decision 015).

# ─── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Node / frontend (Stage 3) ─────────────────────────────────────────
node_modules/
dist/

# ─── Editor / OS ───────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

# Brainstorming visual-companion artifacts
.superpowers/

# Harness scheduled-task lock
.claude/scheduled_tasks.lock
