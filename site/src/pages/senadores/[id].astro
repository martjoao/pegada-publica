---
import Base from "../../layouts/Base.astro";
import { loadSenatorIndex, loadSenator } from "../../lib/data";
import {
  statusLabel,
  statusColor,
  conditionLabel,
  partyColor,
} from "../../lib/labels";

export function getStaticPaths() {
  return loadSenatorIndex().map((c) => ({ params: { id: String(c.id) } }));
}

const { id } = Astro.params;
const sen = loadSenator(id!);
// BASE_URL has no trailing slash in the static build; normalize before concat.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const fmt = (iso: string | null) =>
  iso ? iso.slice(0, 10).split("-").reverse().join("/") : "atual";

// Party-history timeline on a true linear time axis, so legislature bands and
// party segments align. Senate party history is continuous (from /filiacoes), not
// per-term; the legislature bands come from the senator's `terms`.
const now = Date.now();
const toMs = (iso: string | null) => (iso ? new Date(iso).getTime() : now);
const starts = sen.parties.map((p) => toMs(p.start));
const ends = sen.parties.map((p) => toMs(p.end));
const t0 = starts.length ? Math.min(...starts) : now;
const t1 = ends.length ? Math.max(...ends) : now + 1;
const span = Math.max(t1 - t0, 1);
const pct = (ms: number) => ((ms - t0) / span) * 100;

const partySegments = sen.parties.map((p) => {
  const left = pct(toMs(p.start));
  return { ...p, left, width: pct(toMs(p.end)) - left };
});

// Legislature term bounds (Senado terms are 8 years across two legislatures, but
// each legislatura is still a 4-year Feb-1 block; bands cover terms actually held).
const legStart = (l: number) => `${4 * l + 1795}-02-01T00:00`;
const legEnd = (l: number) => `${4 * l + 1799}-02-01T00:00`;
const heldLegislatures = [...new Set(sen.terms.map((t) => t.legislature))].sort(
  (a, b) => a - b,
);
const legBands = heldLegislatures.map((l) => {
  const left = Math.max(pct(toMs(legStart(l))), 0);
  const right = Math.min(pct(toMs(legEnd(l))), 100);
  return { legislature: l, left, width: Math.max(right - left, 0) };
});
const boundaries = legBands.map((b) => b.left).filter((x) => x > 0.5 && x < 99.5);
---

<Base title={`${sen.name} — Pegada Pública`}>
  <a href={`${base}senadores`} class="text-sm text-[#1f3a5f] hover:underline">‹ Senadores</a>

  <div class="mt-3 flex items-center gap-4 border-b-2 border-[#1f3a5f] pb-4">
    {
      sen.photo_url && (
        <img
          src={sen.photo_url}
          alt={sen.name}
          width="84"
          height="108"
          class="rounded bg-slate-200 object-cover"
        />
      )
    }
    <div>
      <h1 class="text-2xl font-bold">{sen.name}</h1>
      <div class="mt-1 flex flex-wrap items-center gap-2 text-sm text-slate-600">
        {
          sen.current_party && (
            <span class="rounded-full bg-[#1f3a5f] px-2 py-0.5 text-xs text-white">
              {sen.current_party}
            </span>
          )
        }
        <span>{sen.state}</span>
        <span class={`rounded-full px-2 py-0.5 text-xs text-white ${statusColor(sen.current_status)}`}>
          {statusLabel(sen.current_status)}
        </span>
        {
          sen.current_condition && (
            <span class="text-slate-500">· {conditionLabel(sen.current_condition)}</span>
          )
        }
      </div>
    </div>
  </div>

  <section class="mt-6">
    <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
      Histórico partidário
    </h2>
    {
      partySegments.length > 0 ? (
        <>
          <div class="relative h-5 w-full">
            {
              legBands.map((b) => (
                <div
                  class="absolute top-0 flex h-full items-center justify-center overflow-hidden border-x border-slate-300 bg-slate-100 text-[10px] font-medium text-slate-500"
                  style={`left:${b.left}%;width:${b.width}%`}
                  title={`${b.legislature}ª Legislatura`}
                >
                  {b.legislature}ª
                </div>
              ))
            }
          </div>
          <div class="relative mt-0.5 h-11 w-full overflow-hidden rounded border border-slate-200">
            {
              partySegments.map((s) => (
                <div
                  class="absolute top-0 flex h-full min-w-0 cursor-default items-center justify-center overflow-hidden px-1 text-[11px] font-semibold text-white"
                  style={`left:${s.left}%;width:${s.width}%;background:${partyColor(s.party)}`}
                  title={`${s.party} · ${fmt(s.start)} → ${fmt(s.end)}`}
                >
                  <span class="truncate">{s.party}</span>
                </div>
              ))
            }
            {
              boundaries.map((x) => (
                <div class="absolute top-0 h-full w-px bg-white/80" style={`left:${x}%`} />
              ))
            }
          </div>
          <div class="mt-1 flex justify-between text-[10px] tabular-nums text-slate-500">
            <span>{fmt(partySegments[0].start)}</span>
            <span>{fmt(partySegments[partySegments.length - 1].end)}</span>
          </div>
        </>
      ) : (
        <p class="text-sm text-slate-400">Sem dados.</p>
      )
    }
  </section>

  <section class="mt-5">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500">
      Mandato e exercício
    </h2>
    <ul class="mt-2 space-y-1">
      {
        sen.office_periods.map((o) => (
          <li class="text-sm">
            <span class="font-medium">{conditionLabel(o.condition)}</span>
            <span class="text-slate-500">
              {" "}— {fmt(o.start)} → {fmt(o.end)}
              {o.legislature && <> · {o.legislature}ª</>}
              {o.cause && <span class="text-slate-400"> ({o.cause})</span>}
            </span>
          </li>
        ))
      }
      {
        sen.office_periods.length === 0 && (
          <li class="text-sm text-slate-400">Sem períodos de exercício registrados.</li>
        )
      }
    </ul>
  </section>

  <section class="mt-5">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500">
      Mandatos por legislatura
    </h2>
    <ul class="mt-2 space-y-1">
      {
        sen.terms.map((t) => (
          <li class="text-sm">
            <span class="font-medium">{t.legislature}ª</span>
            <span class="text-slate-500">
              {" "}— {conditionLabel(t.condition)} · {t.state}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
