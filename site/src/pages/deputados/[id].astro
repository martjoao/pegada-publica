---
import Base from "../../layouts/Base.astro";
import { loadIndex, loadDeputy } from "../../lib/data";
import {
  statusLabel,
  statusColor,
  conditionLabel,
  partyColor,
} from "../../lib/labels";

export function getStaticPaths() {
  return loadIndex().map((c) => ({ params: { id: String(c.id) } }));
}

const { id } = Astro.params;
const dep = loadDeputy(id!);
const base = import.meta.env.BASE_URL;
const fmt = (iso: string | null) =>
  iso ? iso.slice(0, 10).split("-").reverse().join("/") : "atual";

// Party-history timeline on a true linear time axis, so legislature bands and
// party segments align (revealing whether a switch was mid-term or at a boundary).
const now = Date.now();
const toMs = (iso: string | null) => (iso ? new Date(iso).getTime() : now);
const starts = dep.parties.map((p) => toMs(p.start));
const ends = dep.parties.map((p) => toMs(p.end));
const t0 = starts.length ? Math.min(...starts) : now;
const t1 = ends.length ? Math.max(...ends) : now + 1;
const span = Math.max(t1 - t0, 1);
const pct = (ms: number) => ((ms - t0) / span) * 100;

const partySegments = dep.parties.map((p) => {
  const left = pct(toMs(p.start));
  return { ...p, left, width: pct(toMs(p.end)) - left };
});

// Legislature spans (start of one term to the start of the next), clipped to the bar.
const LEG_BOUNDS: Record<number, [string, string]> = {
  56: ["2019-02-01", "2023-02-01"],
  57: ["2023-02-01", "2027-02-01"],
};
const legBands = dep.legislatures
  .filter((l) => LEG_BOUNDS[l])
  .map((l) => {
    const left = Math.max(pct(toMs(LEG_BOUNDS[l][0])), 0);
    const right = Math.min(pct(toMs(LEG_BOUNDS[l][1])), 100);
    return { legislature: l, left, width: Math.max(right - left, 0) };
  });
const boundaries = legBands.map((b) => b.left).filter((x) => x > 0.5 && x < 99.5);
---

<Base title={`${dep.name} — Pegada Pública`}>
  <a href={base} class="text-sm text-[#1f3a5f] hover:underline">‹ Deputados</a>

  <div class="mt-3 flex items-center gap-4 border-b-2 border-[#1f3a5f] pb-4">
    {
      dep.photo_url && (
        <img
          src={dep.photo_url}
          alt={dep.name}
          width="84"
          height="108"
          class="rounded bg-slate-200 object-cover"
        />
      )
    }
    <div>
      <h1 class="text-2xl font-bold">{dep.name}</h1>
      <div class="mt-1 flex flex-wrap items-center gap-2 text-sm text-slate-600">
        {
          dep.current_party && (
            <span class="rounded-full bg-[#1f3a5f] px-2 py-0.5 text-xs text-white">
              {dep.current_party}
            </span>
          )
        }
        <span>{dep.state}</span>
        <span class={`rounded-full px-2 py-0.5 text-xs text-white ${statusColor(dep.current_status)}`}>
          {statusLabel(dep.current_status)}
        </span>
        {
          dep.current_condition && (
            <span class="text-slate-500">· {conditionLabel(dep.current_condition)}</span>
          )
        }
      </div>
    </div>
  </div>

  <section class="mt-6">
    <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
      Histórico partidário
    </h2>
    {
      partySegments.length > 0 ? (
        <>
          <div class="relative h-5 w-full">
            {
              legBands.map((b) => (
                <div
                  class="absolute top-0 flex h-full items-center justify-center overflow-hidden border-x border-slate-300 bg-slate-100 text-[10px] font-medium text-slate-500"
                  style={`left:${b.left}%;width:${b.width}%`}
                  title={`${b.legislature}ª Legislatura`}
                >
                  {b.legislature}ª
                </div>
              ))
            }
          </div>
          <div class="relative mt-0.5 h-11 w-full overflow-hidden rounded border border-slate-200">
            {
              partySegments.map((s) => (
                <div
                  class="absolute top-0 flex h-full min-w-0 cursor-default items-center justify-center overflow-hidden px-1 text-[11px] font-semibold text-white"
                  style={`left:${s.left}%;width:${s.width}%;background:${partyColor(s.party)}`}
                  title={`${s.party} · ${fmt(s.start)} → ${fmt(s.end)} · ${s.legislature}ª Legislatura`}
                >
                  <span class="truncate">{s.party}</span>
                </div>
              ))
            }
            {
              boundaries.map((x) => (
                <div class="absolute top-0 h-full w-px bg-white/80" style={`left:${x}%`} />
              ))
            }
          </div>
          <div class="mt-1 flex justify-between text-[10px] tabular-nums text-slate-500">
            <span>{fmt(partySegments[0].start)}</span>
            <span>{fmt(partySegments[partySegments.length - 1].end)}</span>
          </div>
        </>
      ) : (
        <p class="text-sm text-slate-400">Sem dados.</p>
      )
    }
  </section>

  <section class="mt-5">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500">
      Mandato e exercício
    </h2>
    <ul class="mt-2 space-y-1">
      {
        dep.office_periods.map((o) => (
          <li class="text-sm">
            <span class="font-medium">{conditionLabel(o.condition)}</span>
            <span class="text-slate-500">
              {" "}— {fmt(o.start)} → {fmt(o.end)} · {o.legislature}ª
            </span>
          </li>
        ))
      }
      {
        dep.office_periods.length === 0 && (
          <li class="text-sm text-slate-400">Sem períodos registrados.</li>
        )
      }
    </ul>
  </section>

  {
    dep.names.length > 1 && (
      <section class="mt-5">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500">
          Nomes parlamentares
        </h2>
        <ul class="mt-2 space-y-1">
          {dep.names.map((n) => (
            <li class="text-sm">
              <span class="font-medium">{n.name}</span>
              <span class="text-slate-500"> — desde {fmt(n.start)}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
